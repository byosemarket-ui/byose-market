NODE_ENV=development
HOST=0.0.0.0
PORT=5000
TRUST_PROXY=1
DB_CLIENT=sqlite
MONGO_URI=mongodb://127.0.0.1:27017/byosemarket
MONGO_URI_DEV=mongodb://127.0.0.1:27017/byosemarket
SQLITE_ENABLED=true
SQLITE_DB_PATH=data/byosemarket.sqlite
SQLITE_MIGRATIONS_DIR=server/database/sqlite/migrations
STORAGE_ROOT=storage
UPLOADS_DIR=server/uploads
UPLOADS_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=byosemarket@gmail.com
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_of_secure_admin_password
APP_BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api
# Production VPS example:
# APP_BASE_URL=http://153.75.227.160
# API_BASE_URL=http://153.75.227.160/api
# SQLITE_DB_PATH=/var/www/byosemarket/server/database/byosemarket.sqlite
# UPLOADS_DIR=/var/www/byosemarket/server/uploads
# STORAGE_ROOT=/var/www/byosemarket/server/uploads
PM2_APP_NAME=byosemarket-api
METRICS_TOKEN=replace_with_metrics_token_if_exposed
STARTUP_RECONNECT_DELAY_MS=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000,http://153.75.227.160,https://153.75.227.160,http://153.75.227.160:5000,https://byosemarket.com,https://www.byosemarket.com,https://byosesemarket4.onrender.com