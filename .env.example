NODE_ENV=development
HOST=0.0.0.0
PORT=5000
TRUST_PROXY=1

DB_CLIENT=sqlite
MONGO_URI=mongodb://127.0.0.1:27017/byosemarket
MONGO_URI_DEV=mongodb://127.0.0.1:27017/byosemarket
SQLITE_ENABLED=true
SQLITE_DB_PATH=server/database/byosemarket.sqlite
SQLITE_MIGRATIONS_DIR=server/database/sqlite/migrations

STORAGE_ROOT=server/uploads
UPLOADS_DIR=server/uploads
UPLOADS_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=byosemarket-api
JWT_AUDIENCE=byosemarket-clients

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_of_secure_admin_password

APP_BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api
SERVE_STATIC=true

PM2_APP_NAME=byosemarket-api
METRICS_TOKEN=
STARTUP_RECONNECT_DELAY_MS=5000
LOG_LEVEL=info

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000,http://153.75.227.160,https://153.75.227.160,http://153.75.227.160:5000,https://byosemarket.com,https://www.byosemarket.com

# Optional email / SMTP (requires nodemailer — already in package.json)
# Provider is configurable; smtp is the VPS default.
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=BYOSE Market
EMAIL_FROM_ADDRESS=

# Optional SMS (Africa's Talking)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Optional notifications / webhooks
# SMTP above is used for outbound email. Admin alert destination can also be set in
# Admin Settings → Notifications (stored in DB). Prefer settings over hardcoding.
# NOTIFY_EMAIL_ENABLED also acts as a master switch for admin emails when
# ADMIN_EMAIL_NOTIFICATIONS_ENABLED is unset.
NOTIFY_EMAIL_ENABLED=false
ADMIN_EMAIL_NOTIFICATIONS_ENABLED=
NOTIFY_SMS_ENABLED=false
ADMIN_ALERT_EMAIL=
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
# Notification automation (background worker)
# Controls how quickly queued business events become admin notifications/emails.
NOTIFICATION_AUTOMATION_INTERVAL_MS=2000
NOTIFICATION_AUTOMATION_BATCH_SIZE=12
NOTIFICATION_AUTOMATION_MAX_ATTEMPTS=5
NOTIFICATION_MONITOR_INTERVAL_MS=60000
NOTIFICATION_STUCK_JOB_MS=300000

# Production VPS setup:
# 1. cp deploy/env.production.example .env
# 2. node scripts/ensure-production-env.js
# 3. node scripts/verify-admin-auth-config.js
# 4. npm run pm2:start
#
# To generate a new bcrypt hash and JWT secret locally:
# node scripts/generate-admin-auth-env.js --password "your-secure-password"
#
# Never commit .env to git. GitHub auto-deploy preserves .env on the VPS.

# Payment gateway secrets (Admin → Payment Settings)
# Required to encrypt credentials saved from the admin UI.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_ENCRYPTION_KEY=
# Optional DPO Pay fallback if Admin has not saved credentials yet.
# Admin Payment Settings (encrypted store) is the authoritative source.
# Never commit real Company Tokens. Do not invent LIVE values.
# LIVE checkout is not activated; DPO_LIVE_* is storage fallback only.
# DPO_TEST_COMPANY_TOKEN=
# DPO_TEST_SERVICE_TYPE=
# DPO_LIVE_COMPANY_TOKEN=
# DPO_LIVE_SERVICE_TYPE=
