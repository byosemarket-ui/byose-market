# Production VPS environment template for /root/BYOSESEMARKET4
# Copy to .env on the server: cp deploy/env.production.example .env
# GitHub auto-deploy preserves .env because it is gitignored.

NODE_ENV=production
HOST=127.0.0.1
PORT=5000
TRUST_PROXY=1
LOG_LEVEL=info

DB_CLIENT=sqlite
SQLITE_ENABLED=true
SQLITE_DB_PATH=server/database/byosemarket.sqlite
SQLITE_MIGRATIONS_DIR=server/database/sqlite/migrations

STORAGE_ROOT=/var/lib/byosemarket/uploads
UPLOADS_DIR=/var/lib/byosemarket/uploads
UPLOADS_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=byosemarket-api
JWT_AUDIENCE=byosemarket-clients

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_of_secure_admin_password

APP_BASE_URL=https://byosemarket.com
API_BASE_URL=https://byosemarket.com/api

PM2_APP_NAME=byosemarket-api
STARTUP_RECONNECT_DELAY_MS=5000
NODE_OPTIONS=--max-old-space-size=384 --dns-result-order=ipv4first

CORS_ORIGINS=https://byosemarket.com,https://www.byosemarket.com
METRICS_TOKEN=replace_with_long_random_metrics_token
SERVE_STATIC=false

# Password-reset delivery: configure at least one channel before enabling it.
NOTIFY_EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Byose Market
EMAIL_FROM_ADDRESS=
NOTIFY_SMS_ENABLED=false
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
