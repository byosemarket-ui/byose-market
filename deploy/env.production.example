# Production VPS environment template for /root/byose-market
# (legacy path /root/BYOSESEMARKET4 is still accepted by deploy scripts)
# Copy to .env on the server: cp deploy/env.production.example .env
# GitHub auto-deploy preserves .env because it is gitignored.
# Repository: https://github.com/byosemarket-ui/byose-market

NODE_ENV=production
HOST=127.0.0.1
PORT=5000
TRUST_PROXY=1
LOG_LEVEL=info

DB_CLIENT=sqlite
SQLITE_ENABLED=true
SQLITE_DB_PATH=server/database/byosemarket.sqlite
SQLITE_MIGRATIONS_DIR=server/database/sqlite/migrations

STORAGE_ROOT=/var/lib/byosemarket/uploads
UPLOADS_DIR=/var/lib/byosemarket/uploads
UPLOADS_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=byosemarket-api
JWT_AUDIENCE=byosemarket-clients

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_of_secure_admin_password

APP_BASE_URL=https://byosemarket.com
API_BASE_URL=https://byosemarket.com/api

PM2_APP_NAME=byosemarket-api
STARTUP_RECONNECT_DELAY_MS=5000
NODE_OPTIONS=--max-old-space-size=384 --dns-result-order=ipv4first

CORS_ORIGINS=https://byosemarket.com,https://www.byosemarket.com
METRICS_TOKEN=replace_with_long_random_metrics_token
SERVE_STATIC=false

# Password-reset + admin alert email delivery.
# Set ADMIN_ALERT_EMAIL or configure Admin Settings → Notifications.
# Never commit real SMTP passwords.
NOTIFY_EMAIL_ENABLED=false
ADMIN_EMAIL_NOTIFICATIONS_ENABLED=
ADMIN_ALERT_EMAIL=
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=BYOSE Market
EMAIL_FROM_ADDRESS=
NOTIFY_SMS_ENABLED=false
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Background notification automation worker
NOTIFICATION_AUTOMATION_INTERVAL_MS=2000
NOTIFICATION_AUTOMATION_BATCH_SIZE=12
NOTIFICATION_AUTOMATION_MAX_ATTEMPTS=5

# Payment gateway encryption (required before saving DPO credentials in Admin)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_ENCRYPTION_KEY=
# Optional DPO env fallback — Admin encrypted store is authoritative. Never commit real tokens.
# Do not invent LIVE values. LIVE checkout is not activated.
# DPO_TEST_COMPANY_TOKEN=
# DPO_TEST_SERVICE_TYPE=
# DPO_LIVE_COMPANY_TOKEN=
# DPO_LIVE_SERVICE_TYPE=

