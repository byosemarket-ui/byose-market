{
  "name": "byosemarket-backend",
  "version": "1.0.0",
  "description": "Backend ya Byose Market (byosemarket.com)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "setup:env": "node scripts/setup-env.js",
    "backend:start": "node server/server.js",
    "backend:dev": "nodemon server/server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production --update-env",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production --update-env",
    "pm2:stop": "pm2 delete byosemarket-api",
    "verify:e2e": "node scripts/verify-e2e-step5.mjs",
    "verify:api-routes": "node server/scripts/verify-api-routes.js",
    "verify:upload-flow": "node server/scripts/verify-upload-flow.js",
    "verify:product-images": "node scripts/verify-product-image-flow.mjs",
    "fix:vps-uploads": "bash scripts/fix-vps-uploads-serving.sh",
    "verify:vps-config": "node server/scripts/verify-vps-production-config.js",
    "verify:admin-auth": "node scripts/verify-admin-auth-config.js",
    "verify:admin-settings": "node scripts/verify-admin-settings.js",
    "verify:admin-profile": "node scripts/verify-admin-profile.js",
    "verify:admin-security": "node scripts/verify-admin-security.js",
    "verify:admin-password": "node scripts/verify-admin-password.js",
    "verify:admin-general": "node scripts/verify-admin-general-settings.js",
    "verify:admin-branding": "node scripts/verify-admin-branding.js",
    "verify:admin-delivery": "node scripts/verify-admin-delivery.js",
    "verify:admin-seo": "node scripts/verify-admin-seo.js",
    "verify:admin-logout": "node scripts/verify-admin-logout.js",
    "ensure:production-env": "node scripts/ensure-production-env.js",
    "generate:admin-auth": "node scripts/generate-admin-auth-env.js",
    "setup:vps-proxy": "bash scripts/setup-vps-proxy.sh",
    "verify:integration": "node scripts/validate-product-integration.js && node scripts/validate-color-inventory.js && node scripts/validate-color-variant-images.js && node scripts/validate-variant-cart-payload.js && node scripts/validate-discount-display.js",
    "verify:variant-flow": "node scripts/verify-variant-data-flow.mjs",
    "verify:storefront": "node scripts/verify-storefront-full.mjs",
    "verify:hero-slider": "node scripts/verify-hero-slider-flow.js",
    "verify:modal": "node scripts/verify-modal-redesign.mjs",
    "verify:checkout": "node scripts/verify-checkout-flow.mjs",
    "verify:shopping-flow": "node scripts/verify-shopping-flow-step1.js",
    "verify:checkout-order": "node scripts/verify-checkout-order-step2.js",
    "verify:order-e2e": "node scripts/verify-order-system-step3.js",
    "verify:perf": "node scripts/perf-homepage-smoke.js",
    "verify:query-cache": "node scripts/verify-query-cache.js",
    "verify:production": "node scripts/audit-smoke-local.js && node scripts/perf-homepage-smoke.js && node scripts/verify-query-cache.js && npm run verify:integration && npm run verify:hero-slider && npm run verify:upload-flow"
  },
  "author": "Kwizera Evode",
  "license": "ISC",
  "keywords": [
    "byosemarket",
    "ecommerce",
    "rwanda",
    "shop"
  ],
  "dependencies": {
    "africastalking": "^0.6.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "multer": "^2.1.1",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "playwright": "^1.62.1"
  }
}
